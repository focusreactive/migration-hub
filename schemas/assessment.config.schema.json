{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "workspace": {
      "default": {
        "path": "../assessments"
      },
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "crawl": {
      "default": {},
      "type": "object",
      "properties": {
        "maxPages": {
          "default": 5000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "default": 4,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "requestDelayMs": {
          "default": 250,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timeoutMs": {
          "default": 30000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "userAgent": {
          "default": "FocusReactiveAssessment/0.1 (+https://focusreactive.com)",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stitch": {
      "default": {},
      "type": "object",
      "properties": {
        "viewport": {
          "default": {
            "width": 1440,
            "height": 900
          },
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
